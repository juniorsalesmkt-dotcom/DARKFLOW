rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return true;
    }

    function isOwner(userId) {
      return true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if true;
    }

    // Users
    match /users/{userId} {
      allow read, write: if true;
    }

    // Pages
    match /pages/{pageId} {
      allow read, write: if true;
    }

    // Templates
    match /templates/{templateId} {
      allow read, write: if true;
    }

    // Videos
    match /videos/{videoId} {
      allow read, write: if true;
    }

    // Productions
    match /productions/{productionId} {
      allow read, write: if true;

      match /items/{itemId} {
        allow read, write: if true;
      }
    }

    // Exports
    match /exports/{exportId} {
      allow read, write: if true;
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // Tags
    match /tags/{tagId} {
      allow read, write: if true;
    }
  }
}
